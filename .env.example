APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://127.0.0.1:5173
# Origens adicionais exatas, separadas por vírgula. Não use wildcard, caminhos ou credenciais.
CORS_ALLOWED_ORIGINS=
# IPs/CIDRs exatos do proxy reverso. Use * apenas em rede isolada controlada.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENT_DISK=local
DOCUMENT_MAX_KB=10240
DOCUMENT_ANTIVIRUS_ENABLED=false
DOCUMENT_ANTIVIRUS_BINARY=
DOCUMENT_ANTIVIRUS_TIMEOUT=30
OPPORTUNITY_PHOTO_DISK=public
OPPORTUNITY_PHOTO_URL=
VISUALIZATION_DISK=local
VISUALIZATION_MAX_IMAGE_KB=25600
VISUALIZATION_MAX_MODEL_KB=65536
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Para envio real: MAIL_MAILER=resend, chave Resend e remetente do domínio verificado.
RESEND_API_KEY=
# Opcional: bundle de autoridades certificadoras confiadas pelo ambiente; nunca use verify=false.
HTTP_CA_BUNDLE=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IA: modo determinístico funciona sem provedor externo. Para redação opcional pelo Responses API,
# use AI_PROVIDER=openai e configure a chave somente no backend.
AI_PROVIDER=deterministic
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-5-mini
AI_LOCAL_ENDPOINT=http://127.0.0.1:11434
AI_LOCAL_MODEL=qwen2.5:3b
AI_LOCAL_TIMEOUT=120
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_EMBEDDING_DIMENSIONS=1024
AI_VECTOR_ENABLED=false
AI_QDRANT_ENDPOINT=http://127.0.0.1:6333
AI_QDRANT_API_KEY=
AI_QDRANT_COLLECTION=ai_knowledge_v1
AI_QDRANT_TIMEOUT=15
AI_WORKER_ENDPOINT=http://127.0.0.1:8010
AI_WORKER_TOKEN=
AI_WORKER_TIMEOUT=30
AI_WORKER_PROCESSING_TIMEOUT=1800
VISUALIZATION_MAX_CONCURRENT_RECONSTRUCTIONS_PER_TENANT=1
COLMAP_EXECUTABLE=
VISUALIZATION_MAX_CAPTURE_IMAGES=120
VISUALIZATION_MAX_PROCESSING_STORAGE_MB=512
AI_MAX_TOOL_CALLS=6
AI_SESSION_RETENTION_DAYS=90

# Google é usado para contexto do entorno do imóvel. Sem chave, o sistema tenta OpenStreetMap.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter

# InvestFlip Real Estate Data / ITBI São Paulo
ITBI_SP_ENABLED=true
ITBI_SP_SOURCE_URL=
# Hosts adicionais exatos para arquivos/redirecionamentos HTTPS; host da fonte já é permitido.
ITBI_ALLOWED_DOWNLOAD_HOSTS=
ITBI_MAX_DOWNLOAD_BYTES=262144000
ITBI_MAX_DISCOVERY_BYTES=2097152
ITBI_SP_STORAGE_DISK=local
ITBI_SP_STORAGE_PATH=real-estate-data/itbi/sp/raw
ITBI_SP_IMPORT_DAY=5
GEOCODING_MINIMUM_PRECISION=RANGE_INTERPOLATED
AVM_TRANSACTION_VALUE_FIELD=declared_transaction_value
AVM_MIN_PRICE_M2=1000
AVM_MAX_PRICE_M2=100000
AVM_MAX_TRANSACTION_AGE_MONTHS=24
AVM_MIN_BUILDING_TRANSACTIONS=2
AVM_MIN_RADIUS_TRANSACTIONS=3
AVM_MIN_NEIGHBORHOOD_TRANSACTIONS=5

# InvestFlip Market Data Providers
# Cartórios não têm API pública nacional. Sem estas variáveis a análise usa ITBI em dados abertos.
CARTORIOS_API_URL=
CARTORIOS_API_TOKEN=

# ITBI próprio é opcional. Sem URL, o sistema consulta catálogos CKAN públicos (SP, Fortaleza, Rio, dados.gov.br).
ITBI_API_URL=
ITBI_API_TOKEN=
SP_ITBI_API_URL=
SP_DADOS_ABERTOS_CKAN_URL=https://dados.prefeitura.sp.gov.br/api/3/action/package_search
SP_DADOS_ABERTOS_DATASTORE_URL=https://dados.prefeitura.sp.gov.br/api/3/action/datastore_search
FORTALEZA_CKAN_URL=https://dados.fortaleza.ce.gov.br/api/3/action/package_search
FORTALEZA_CKAN_DATASTORE_URL=https://dados.fortaleza.ce.gov.br/api/3/action/datastore_search
RJ_CKAN_URL=https://www.data.rio/api/3/action/package_search
RJ_CKAN_DATASTORE_URL=https://www.data.rio/api/3/action/datastore_search
DADOS_GOV_CKAN_URL=https://dados.gov.br/api/3/action/package_search
DADOS_GOV_DATASTORE_URL=https://dados.gov.br/api/3/action/datastore_search

# Bases municipais/prefeituras com vendas/transações normalizadas.
PREFEITURA_TRANSACOES_API_URL=
PREFEITURA_TRANSACOES_API_TOKEN=

# Opcional: caminho do Chrome/Chromium/Edge. Vazio usa detecção local.
NODE_BINARY=
CHROME_PATH=
# Habilite somente em ambiente isolado que não suporte o sandbox do navegador.
SCRAPER_DISABLE_SANDBOX=false

# Apify: token em Console > Settings > Integrations. Os atores rodam em paralelo.
APIFY_API_TOKEN=
APIFY_MAX_RESULTS_PER_PROVIDER=25
APIFY_ACTOR_TIMEOUT=45
APIFY_REQUEST_TIMEOUT=55
# Opcional: use outro actor sem alterar o código. Casa Mineira fica no coletor local enquanto estiver vazio.
APIFY_ACTOR_ZAP=avorio/zap-imoveis-scraper
APIFY_ACTOR_VIVAREAL=scrapers_lat/vivareal-scraper
APIFY_ACTOR_IMOVELWEB=piotrv1001/imovelweb-listings-scraper
APIFY_ACTOR_LOFT=gio21/loft-scraper
APIFY_ACTOR_QUINTOANDAR=solidcode/quintoandar-scraper
APIFY_ACTOR_FACEBOOK=apify/facebook-marketplace-scraper
APIFY_ACTOR_CASA_MINEIRA=

# Limite cumulativo de células com linhas expandidas em ODS. Para bases maiores, use CSV.
ITBI_MAX_ODS_EXPANDED_CELLS=2000000
