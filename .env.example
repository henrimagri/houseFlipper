APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google é usado para contexto do entorno do imóvel. Sem chave, o sistema tenta OpenStreetMap.
GOOGLE_MAPS_API_KEY=
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter

# InvestFlip Real Estate Data / ITBI São Paulo
ITBI_SP_ENABLED=true
ITBI_SP_SOURCE_URL=
ITBI_SP_STORAGE_DISK=local
ITBI_SP_STORAGE_PATH=real-estate-data/itbi/sp/raw
ITBI_SP_IMPORT_DAY=5
GOOGLE_GEOCODING_ENABLED=true
GEOCODING_MINIMUM_PRECISION=RANGE_INTERPOLATED
AVM_TRANSACTION_VALUE_FIELD=declared_transaction_value
AVM_MIN_PRICE_M2=1000
AVM_MAX_PRICE_M2=100000
AVM_MAX_TRANSACTION_AGE_MONTHS=24
AVM_MIN_BUILDING_TRANSACTIONS=2
AVM_MIN_RADIUS_TRANSACTIONS=3
AVM_MIN_NEIGHBORHOOD_TRANSACTIONS=5

# InvestFlip Market Data Providers
# Cartórios geralmente exigem contrato/API privada.
CARTORIOS_API_URL=
CARTORIOS_API_TOKEN=

# ITBI pode variar por município. Para São Paulo, use SP_ITBI_API_URL quando tiver CSV/JSON oficial/contratado.
ITBI_API_URL=
ITBI_API_TOKEN=
SP_ITBI_API_URL=
SP_DADOS_ABERTOS_CKAN_URL=https://dados.prefeitura.sp.gov.br/api/3/action/package_search

# Bases municipais/prefeituras com vendas/transações normalizadas.
PREFEITURA_TRANSACOES_API_URL=
PREFEITURA_TRANSACOES_API_TOKEN=
