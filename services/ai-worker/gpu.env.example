# Use uma imagem interna previamente validada e fixada por sha256.
AI_WORKER_GPU_IMAGE=registry.example/flipcontrol-ai-worker-gpu@sha256:substitua-pelo-digest-validado
AI_WORKER_TOKEN=replace-with-a-random-internal-token
AI_WORKER_GPU_PORT=8010
AI_WORKER_RETENTION_HOURS=72
AI_WORKER_MAX_UPLOAD_MB=512
COLMAP_EXECUTABLE=/usr/local/bin/colmap
COLMAP_DENSE_MESHER=poisson
COLMAP_DENSE_MAX_IMAGE_SIZE=2400
COLMAP_GPU_INDEX=0
# No Windows, mantenha false enquanto o subprocesso Poisson do COLMAP não encerrar
# de forma confiável. Em Linux, o worker usa true por padrão.
AI_POISSON_ENABLED=true
AI_POISSON_TIMEOUT=180
# O modo score/12/2 preserva o baseline. Use coverage somente em benchmarks
# controlados; candidatos continuam sujeitos aos gates geométrico e visual.
AI_STEREO_SELECTION=score
AI_STEREO_MAX_PAIRS=12
AI_STEREO_PAIRS_PER_VIEW=2
AI_STEREO_ADAPTIVE_DISPARITY=true
AI_STEREO_COVERAGE_GRID=6
AI_STEREO_GAIN_FLOOR=0.0025
AI_STEREO_COVERAGE_VOXEL=0.10
NVIDIA_VISIBLE_DEVICES=all
