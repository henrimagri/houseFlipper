APP_NAME=FlipControl
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_PROXIES=10.0.0.0/8

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=flipcontrol
DB_USERNAME=flipcontrol
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=720
SANCTUM_TOKEN_PREFIX=flipcontrol_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=local
DOCUMENT_DISK=local
DOCUMENT_MAX_KB=10240
DOCUMENT_ANTIVIRUS_ENABLED=true
DOCUMENT_ANTIVIRUS_BINARY=/usr/bin/clamscan
DOCUMENT_ANTIVIRUS_TIMEOUT=30
OPPORTUNITY_PHOTO_DISK=public
OPPORTUNITY_PHOTO_URL=https://cdn.example.com/storage

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=FlipControl
HTTP_CA_BUNDLE=

ITBI_SP_ENABLED=true
ITBI_SP_SOURCE_URL=
ITBI_ALLOWED_DOWNLOAD_HOSTS=
ITBI_MAX_DOWNLOAD_BYTES=262144000
ITBI_MAX_DISCOVERY_BYTES=2097152
ITBI_SP_STORAGE_DISK=local
ITBI_SP_STORAGE_PATH=real-estate-data/itbi/sp/raw
ITBI_MAX_ODS_EXPANDED_CELLS=2000000

NODE_BINARY=/usr/bin/node
CHROME_PATH=/usr/bin/chromium
SCRAPER_DISABLE_SANDBOX=false
